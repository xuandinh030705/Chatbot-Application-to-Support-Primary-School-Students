# Copy this file to .env and fill in your secrets
# For local development, fill src/backend/.env and src/frontend/.env separately
# See src/backend/.env.example and src/frontend/.env.example for details

# Backend
# OPENAI_API_KEY=your_openai_api_key_here
# GROQ_API_KEY=your_groq_api_key_here
# DB_HOST=localhost
# DB_PORT=3400
# DB_NAME=chatbot_db
# DB_USER=chatbot_user
# DB_PASSWORD=chatbot_pass

# Frontend
# VITE_API_BASE_URL=http://localhost:8000
