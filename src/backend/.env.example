# ==========================
# LLM API Keys
# ==========================
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Optional - only if your OpenAI account requires org/project scoping
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=

# Optional
GOOGLE_CAPTCHA_SECRET=

# ==========================
# Database (MySQL)
# ==========================
DB_HOST=localhost
DB_PORT=3400
DB_NAME=chatbot_db
DB_USER=chatbot_user
DB_PASSWORD=chatbot_pass

# Alternative: full connection string (overrides DB_* if set in docker-compose)
# DATABASE_URL=mysql+pymysql://chatbot_user:chatbot_pass@localhost:3400/chatbot_db

# ==========================
# App
# ==========================
FRONTEND_URL=http://localhost:5173
